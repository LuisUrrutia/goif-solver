# Copy to .env, fill only the values your configuration needs, and load it in Bash.
# The solver does not load this file automatically. Keep values single-quoted.

# Optional on loopback; required for protected controls or a non-loopback listener.
# Use a random token of at least 32 characters.
GOIF_CONTROL_TOKEN=''

# Required for config/testnet.json, including observation mode.
# Review the primary identity with storage-check before setting its run ID.
GOIF_REDIS_URL=''
GOIF_REDIS_PRIMARY_RUN_ID=''

# Optional RPC overrides. Empty values use the public URLs in config/testnet.json.
SEPOLIA_RPC_URL=''
BASE_SEPOLIA_RPC_URL=''

# Optional additional RPC providers for failover.
SEPOLIA_FALLBACK_RPC_URL=''
BASE_SEPOLIA_FALLBACK_RPC_URL=''

# Required for LI.FI registration, quote publication, and withdrawal.
LIFI_API_KEY=''

# Required for execution with Polymer and authenticated proof checks.
POLYMER_API_KEY=''

# Required for transaction signing and new identity challenges; match the signer.
SOLVER_PRIVATE_KEY=''
